
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasAccount() {
      return request.auth != null;
    }

    function verified() {
      return hasAccount() &&
        request.auth.token.email_verified == true;
    }

    function isTutor() {
      return verified() &&
        request.auth.uid == "Yw2zbZef0lWUnq85M9hgGyBjpPj2";
    }

    function hasStudentAccess(data) {
      return verified() && (
        request.auth.uid in data.get('parentUids', []) ||
        request.auth.uid in data.get('studentUids', [])
      );
    }

    function canReadStudent(studentId) {
      return isTutor() || hasStudentAccess(
        get(
          /databases/$(database)/documents/students/$(studentId)
        ).data
      );
    }

    match /profiles/{uid} {

      allow create: if hasAccount() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasAll(
          ['email', 'name', 'role', 'createdAt']
        ) &&
        request.resource.data.keys().hasOnly(
          ['email', 'name', 'role', 'createdAt']
        ) &&
        request.resource.data.email ==
          request.auth.token.email &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.role in ['student', 'parent'] &&
        request.resource.data.createdAt == request.time;

      allow get: if isTutor() ||
        (verified() && request.auth.uid == uid);

      allow list: if isTutor();

      allow update, delete: if false;
    }

    match /students/{studentId} {

      allow get, list: if isTutor() ||
        hasStudentAccess(resource.data);

      allow create, update, delete: if isTutor();

      match /grades/{gradeId} {

        allow get, list: if isTutor() || (
          canReadStudent(studentId) &&
          resource.data.published == true
        );

        allow create, update, delete: if isTutor();
      }
    }

    match /{everything=**} {
      allow read, write: if false;
    }
  }
}
